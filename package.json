{
  "name": "resource-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:init": "wrangler d1 migrations apply DB --local --env local",
    "db:seed": "wrangler d1 execute DB --local --env local --file scripts/seed.sql",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --env=\"\" --containers-rollout=none --outdir dist",
    "test": "node --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev:web": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "build:container": "docker build --platform linux/amd64 -t shicang-pansou ."
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "hono": "^4.13.7",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.131.1"
  }
}
